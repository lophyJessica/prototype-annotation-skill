{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Vitamin Prototype Annotation Config",
  "type": "object",
  "required": ["version", "annotations"],
  "properties": {
    "version": { "type": "integer", "minimum": 1 },
    "title": { "type": "string" },
    "scope": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$" },
    "sourceBase": { "type": "string" },
    "runtime": {
      "type": "object",
      "properties": {
        "zIndexBase": { "type": "integer", "minimum": 0, "maximum": 2147483000 },
        "initialMode": { "type": "string", "enum": ["preview", "annotate"] }
      }
    },
    "sourceRequirements": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "source"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "source": { "type": "string", "minLength": 1 },
          "page": { "type": "string" }
        }
      }
    },
    "annotations": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "moduleName", "target"],
        "properties": {
          "id": { "type": ["string", "integer"] },
          "key": { "type": "string", "minLength": 1 },
          "page": { "type": "string" },
          "routeMatcher": { "type": "string" },
          "moduleName": { "type": "string", "minLength": 1 },
          "target": {
            "type": "object",
            "required": ["selector"],
            "properties": {
              "selector": { "type": "string", "minLength": 1 },
              "fallbackSelectors": { "type": "array", "items": { "type": "string" } },
              "activationHint": { "type": "string" }
            }
          },
          "markdownFile": { "type": "string" },
          "blockId": { "type": ["string", "integer"] },
          "markdown": { "type": "string" },
          "sourceRefs": { "type": "array", "items": { "type": "string" } },
          "order": { "type": "number" }
        }
      }
    }
  }
}
